# Produccion - Docker Compose
DEBUG=False
SECRET_KEY=change-me-in-production

POSTGRES_DB=inventario
POSTGRES_USER=inventario_user
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgres://inventario_user:cambia-esto@db:5432/inventario
DATABASE_SSL_REQUIRE=False

ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tu-dominio.com
EMAIL_PORT=587
EMAIL_HOST_USER=usuario
EMAIL_HOST_PASSWORD=clave
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@tu-dominio.com

# Produccion: no generar seed de desarrollo
SEED_DEV_DATA_100=false
SEED_DEV_COUNT=100
SEED_DEV_RESET=false

# Gunicorn y frontend
GUNICORN_WORKERS=4
FRONTEND_PORT=80
VITE_API_URL=/api/v1
