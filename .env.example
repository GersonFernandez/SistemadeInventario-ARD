# Docker Compose dev environment
DEBUG=True
SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=postgres://inventario_user:inventario_pass@db:5432/inventario
DATABASE_SSL_REQUIRE=False
POSTGRES_DB=inventario
POSTGRES_USER=inventario_user
POSTGRES_PASSWORD=inventario_pass
POSTGRES_PORT=5432
BACKEND_PORT=8001
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8001/api/v1
GUNICORN_WORKERS=3
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@armada.local

# Dev seed controls
SEED_DEV_DATA_100=true
SEED_DEV_COUNT=100
SEED_DEV_RESET=false
